# ═══════════════════════════════════════════
# Gradle 产物（在容器内重新构建）
# ═══════════════════════════════════════════
.gradle/
**/build/
!gradle/wrapper/

# ═══════════════════════════════════════════
# IDE / 编辑器文件
# ═══════════════════════════════════════════
.idea/
.vscode/
*.iml
*.iws
*.ipr

# ═══════════════════════════════════════════
# 不参与 server 构建的平台模块 — 源码排除以减小 COPY 体积
# 但保留 build.gradle.kts（settings.gradle.kts 引用了它们，Gradle 配置阶段需要）
# ═══════════════════════════════════════════
androidApp/src/
composeApp/src/

# ═══════════════════════════════════════════
# 文档和其他非必要文件
# ═══════════════════════════════════════════
*.md
.git/
.gitignore
.env
tmp/
local.properties

# ═══════════════════════════════════════════
# Node.js / 前端及协作模块 — 排除无用依赖与运行中产生的临时文件
# ═══════════════════════════════════════════
**/node_modules/
**/dist/
**/dist-webview/

# 协作后端由独立的容器（collab-server）运行，完全不参与 Ktor 服务端的构建
collab-server/

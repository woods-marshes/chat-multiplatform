import com.github.woodsmarshes.chat.core.model.MessageCategory;
import com.github.woodsmarshes.chat.core.model.MessageContent;
import com.github.woodsmarshes.chat.core.model.MessageRenderType;
import com.github.woodsmarshes.chat.core.model.MessageStatus;
import kotlin.time.Instant;
import kotlin.uuid.Uuid;

CREATE TABLE MessageEntity (
    id BLOB AS Uuid NOT NULL PRIMARY KEY,
    conversation_id BLOB AS Uuid NOT NULL,
    user_id BLOB AS Uuid NOT NULL,
    category TEXT AS MessageCategory NOT NULL, -- TEXT, IMAGE, VIDEO 等
    render_type TEXT AS MessageRenderType NOT NULL,
    content TEXT AS MessageContent NOT NULL, -- JSON 内容
    reply_to_message_id BLOB AS Uuid,
    created_at INTEGER AS Instant NOT NULL,
    revoked_at INTEGER AS Instant,
    local_send_status TEXT AS MessageStatus,
    -- False only for rows persisted purely as reply targets (outside the
    -- local timeline window); keeps Paging anchors free of stray old rows.
    in_timeline INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    FOREIGN KEY (conversation_id) REFERENCES ConversationEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES UserEntity(id) ON DELETE RESTRICT,
    FOREIGN KEY (reply_to_message_id) REFERENCES MessageEntity(id) ON DELETE SET NULL
);

CREATE INDEX idx_message_conversation_time ON MessageEntity(conversation_id, created_at DESC);
CREATE INDEX idx_message_pagination ON MessageEntity(conversation_id, id DESC);

-- 插入新消息（同步或本地发送）
insertMessage:
INSERT OR REPLACE INTO MessageEntity(
    id, conversation_id, user_id, category, render_type, content,
    reply_to_message_id, created_at, revoked_at, local_send_status
) VALUES ?;

upsertMessage:
INSERT INTO MessageEntity(
    id,
    conversation_id,
    user_id,
    category,
    render_type,
    content,
    reply_to_message_id,
    created_at,
    revoked_at,
    local_send_status,
    in_timeline
)
VALUES ?
ON CONFLICT(id) DO UPDATE SET
    category            = excluded.category,
    render_type         = excluded.render_type,
    content             = excluded.content,
    reply_to_message_id = excluded.reply_to_message_id,
    -- The server timestamp is authoritative once the message is acked.
    created_at          = excluded.created_at,
    revoked_at          = COALESCE(excluded.revoked_at, revoked_at),
    local_send_status   = COALESCE(excluded.local_send_status, local_send_status),
    in_timeline         = MAX(MessageEntity.in_timeline, excluded.in_timeline);

-- 【增/播种】reply 目标等时间轴外行的写入：已存在的行一律不动
-- （不降级 in_timeline、不触发 reply 外键的 ON DELETE SET NULL 副作用）。
seedMessage:
INSERT OR IGNORE INTO MessageEntity(
    id,
    conversation_id,
    user_id,
    category,
    render_type,
    content,
    reply_to_message_id,
    created_at,
    revoked_at,
    local_send_status,
    in_timeline
)
VALUES ?;

-- 分页查询：获取某个会话中早于某个时间点的消息（用于下拉加载更多）
getMessagesPaged:
SELECT * FROM MessageEntity
WHERE conversation_id = :conversationId AND created_at < :beforeTimestamp
ORDER BY created_at DESC
LIMIT :limit;

-- 边界计算查询:
-- No zeroblob(16) seed row for empty databases: since SQLDelight 2.4.0
-- (#6284) KeyedQueryPagingSource handles an empty boundary result itself.
messageBoundaries:
SELECT t.id
FROM (
  SELECT
    id,
    CASE
      WHEN ((row_number() OVER (ORDER BY id DESC) - 1) % CAST(:limit AS INTEGER)) = 0 THEN 1
      WHEN id = :referenceId THEN 1
      ELSE 0
    END AS page_boundary
  FROM MessageEntity
  WHERE conversation_id = :conversationId
    AND in_timeline = 1
  ORDER BY id DESC
) AS t
WHERE page_boundary = 1;

-- 区间查询(uuid v7):
keyedMessagesWithRelations:
SELECT m.*,
    u.username AS senderUsername,
    u.avatar AS senderAvatar,
    u.display_name AS senderDisplayName,

    par.role AS senderRole,
    par.settings AS senderParticipantSettings,

    reply_target.id AS reply_id,
    reply_target.conversation_id AS reply_conversation_id,
    reply_target.user_id AS reply_user_id,
    reply_target.category AS reply_category,
    reply_target.render_type AS reply_render_type,
    reply_target.content AS reply_content,
    reply_target.reply_to_message_id AS reply_reply_to_message_id,
    reply_target.created_at AS reply_created_at,
    reply_target.revoked_at AS reply_revoked_at,
    reply_target.local_send_status AS reply_local_send_status,

    reply_user.username AS reply_senderUsername,
    reply_user.avatar AS reply_senderAvatar,
    reply_user.display_name AS reply_senderDisplayName,

    reply_par.role AS reply_senderRole,
    reply_par.settings AS reply_senderParticipantSettings
FROM MessageEntity AS m
LEFT JOIN UserEntity AS u ON m.user_id = u.id
LEFT JOIN ParticipantEntity AS par ON u.id = par.user_id AND par.conversation_id = m.conversation_id
LEFT JOIN MessageEntity AS reply_target ON m.reply_to_message_id = reply_target.id
LEFT JOIN UserEntity AS reply_user ON reply_target.user_id = reply_user.id
LEFT JOIN ParticipantEntity AS reply_par
    ON reply_user.id = reply_par.user_id
    AND reply_par.conversation_id = m.conversation_id
WHERE m.conversation_id = :conversationId
  AND m.in_timeline = 1
  AND m.id <= :beginInclusive
  AND (m.id > :endExclusive OR :endExclusive IS NULL)
ORDER BY m.id DESC;


-- 分页获取消息
getMessagesWithAllRelationsByPage:
SELECT m.*,
    u.username AS senderUsername,
    u.avatar AS senderAvatar,
    u.display_name AS senderDisplayName,

    par.role AS senderRole,
    par.settings AS senderParticipantSettings,

    reply_target.id AS reply_id,
    reply_target.conversation_id AS reply_conversation_id,
    reply_target.user_id AS reply_user_id,
    reply_target.category AS reply_category,
    reply_target.render_type AS reply_render_type,
    reply_target.content AS reply_content,
    reply_target.reply_to_message_id AS reply_reply_to_message_id,
    -- 即使回复消息本身又是回复，也拉取
    reply_target.created_at AS reply_created_at,
    reply_target.revoked_at AS reply_revoked_at,
    reply_target.local_send_status AS reply_local_send_status,

    reply_user.username AS reply_senderUsername,
    reply_user.avatar AS reply_senderAvatar,
    reply_user.display_name AS reply_senderDisplayName,

    reply_par.role AS reply_senderRole,
    reply_par.settings AS reply_senderParticipantSettings
FROM MessageEntity AS m
LEFT JOIN UserEntity AS u ON m.user_id = u.id
LEFT JOIN ParticipantEntity AS par ON u.id = par.user_id AND par.conversation_id = m.conversation_id
LEFT JOIN MessageEntity AS reply_target ON m.reply_to_message_id = reply_target.id
LEFT JOIN UserEntity AS reply_user ON reply_target.user_id = reply_user.id
LEFT JOIN ParticipantEntity AS reply_par
    ON reply_user.id = reply_par.user_id
    AND reply_par.conversation_id = m.conversation_id
WHERE m.conversation_id = :conversationId
  AND m.in_timeline = 1
  AND (:beforeId IS NULL OR m.id < :beforeId)
ORDER BY m.id DESC
LIMIT :limit;

-- 批量获取被回复的消息详情
getMessagesWithAllRelationsByIds:
SELECT m.*,
    u.username AS senderUsername,
    u.avatar AS senderAvatar,
    u.display_name AS senderDisplayName,

    par.role AS senderRole,
    par.settings AS senderParticipantSettings
FROM MessageEntity AS m
LEFT JOIN UserEntity AS u ON m.user_id = u.id
LEFT JOIN ParticipantEntity AS par ON u.id = par.user_id AND par.conversation_id = m.conversation_id
WHERE m.id IN :ids;

-- 最新消息：获取会话的最后一条消息（用于消息列表预览）
getLatestMessage:
SELECT m.*,
    u.username AS senderUsername,
    u.avatar AS senderAvatar,
    u.display_name AS senderDisplayName,
    par.role AS senderRole,
    par.settings AS senderParticipantSettings
FROM MessageEntity AS m
LEFT JOIN UserEntity AS u ON m.user_id = u.id
LEFT JOIN ParticipantEntity AS par ON m.conversation_id = par.conversation_id AND m.user_id = par.user_id
WHERE m.conversation_id = :conversationId
ORDER BY m.created_at DESC, m.id DESC
LIMIT 1;

getLatestMessages:
SELECT m.*,
    u.username AS senderUsername,
    u.avatar AS senderAvatar,
    u.display_name AS senderDisplayName,
    par.role AS senderRole,
    par.settings AS senderParticipantSettings
FROM ConversationEntity AS c
JOIN MessageEntity AS m ON c.last_message_id = m.id
LEFT JOIN UserEntity AS u ON m.user_id = u.id
LEFT JOIN ParticipantEntity AS par ON m.conversation_id = par.conversation_id AND m.user_id = par.user_id
WHERE c.id IN :conversationIds;

-- 单条消息详情
getMessageById:
SELECT m.*,
   u.username AS senderUsername,
   u.avatar AS senderAvatar,
   u.display_name AS senderDisplayName,

   par.role AS senderRole,
   par.settings AS senderParticipantSettings
FROM MessageEntity AS m
LEFT JOIN UserEntity AS u ON m.user_id = u.id
LEFT JOIN ParticipantEntity AS par ON u.id = par.user_id AND par.conversation_id = m.conversation_id
WHERE m.id = :id;

-- 获取某条消息的所有回复（简单二级关联）
getRepliesToMessage:
SELECT * FROM MessageEntity
WHERE reply_to_message_id = :messageId
ORDER BY created_at ASC;

-- 更新发送状态（本地发送成功后，从 SENDING 改为 SENT）
updateMessageStatus:
UPDATE MessageEntity
SET local_send_status = :status,
    created_at = :createdAt,
    id = :newId -- 如果服务器返回了正式 ID，可以替换本地生成的临时 ID
WHERE id = :oldId;

-- Outbox: messages still pending after `retryAfter` are eligible for resend.
getRetryableMessages:
SELECT * FROM MessageEntity
WHERE local_send_status = 'SENDING' AND COALESCE((SELECT last_attempt_ms FROM MessageAttempt WHERE message_id = lower(hex(MessageEntity.id))), created_at) < :retryAfter
ORDER BY created_at ASC;

-- Outbox: give up on messages older than the TTL so bubbles stop spinning.
failStaleMessages:
UPDATE MessageEntity
SET local_send_status = 'FAILED'
WHERE local_send_status = 'SENDING' AND COALESCE((SELECT started_at_ms FROM MessageAttempt WHERE message_id = lower(hex(MessageEntity.id))), created_at) < :giveUpBefore;

-- 撤回消息
revokeMessage:
UPDATE MessageEntity
SET revoked_at = :revokedAt
WHERE id = :id AND revoked_at IS NULL;

-- 删除单条消息（本地删除）
deleteMessage:
DELETE FROM MessageEntity WHERE id = :id;

-- 清空会话历史记录
clearConversationHistory:
DELETE FROM MessageEntity WHERE conversation_id = :conversationId;

-- 计算会话中的未读数。
-- 按消息 id 比较（UUIDv7 时间有序）；upsertMessage 会以服务器时间戳覆盖
-- created_at，因此不能依赖时间戳比较。lastReadMessageId 为 NULL 表示从未
-- 读过，会话内他人消息全部计入。
countUnreadAfter:
SELECT COUNT(*) FROM MessageEntity
WHERE conversation_id = :conversationId
AND user_id != :myUserId
AND (:lastReadMessageId IS NULL OR id > :lastReadMessageId);
-- Attempt clocks are independent of the immutable message timeline.
CREATE TABLE MessageAttempt (
    message_id TEXT NOT NULL PRIMARY KEY,
    started_at_ms INTEGER NOT NULL,
    last_attempt_ms INTEGER NOT NULL
);

CREATE TABLE ScopeSyncCursor (
    scope TEXT NOT NULL,
    scope_id TEXT NOT NULL,
    revision INTEGER NOT NULL,
    PRIMARY KEY (scope, scope_id)
);

-- Crash-safe unread badge recovery, kept SEPARATE from ScopeSyncCursor on
-- purpose: a pending row must never make an uninitialized conversation look
-- like it has a sync cursor (cursor presence decides snapshot vs journal
-- replay). generation increases on every re-mark so a stale in-flight detail
-- response can only confirm the exact task it served.
CREATE TABLE UnreadRefreshPending (
    conversation_id TEXT NOT NULL PRIMARY KEY,
    pending INTEGER NOT NULL DEFAULT 1,
    generation INTEGER NOT NULL
);

startAttempt:
INSERT INTO MessageAttempt(message_id, started_at_ms, last_attempt_ms)
VALUES (:messageId, :nowMs, :nowMs)
ON CONFLICT(message_id) DO UPDATE SET started_at_ms = excluded.started_at_ms, last_attempt_ms = excluded.last_attempt_ms;

recordAttempt:
INSERT INTO MessageAttempt(message_id, started_at_ms, last_attempt_ms)
VALUES (:messageId, :createdAtMs, :nowMs)
ON CONFLICT(message_id) DO UPDATE SET last_attempt_ms = excluded.last_attempt_ms;

clearAttempt:
DELETE FROM MessageAttempt WHERE message_id = :messageId;

replaceReplyReferences:
UPDATE MessageEntity SET reply_to_message_id = :newId WHERE reply_to_message_id = :oldId;

replaceConversationReferences:
UPDATE ConversationEntity SET last_message_id = :newId WHERE last_message_id = :oldId;

replaceReadReferences:
UPDATE ParticipantEntity SET last_read_message_id = :newId WHERE last_read_message_id = :oldId;

getScopeCursor:
SELECT revision FROM ScopeSyncCursor WHERE scope = :scope AND scope_id = :scopeId;

setScopeCursor:
INSERT INTO ScopeSyncCursor(scope, scope_id, revision) VALUES (:scope, :scopeId, :revision)
ON CONFLICT(scope, scope_id) DO UPDATE SET revision = excluded.revision;

-- (Re)marks the conversation as owing one authoritative unread refresh. Rows
-- are never deleted: generation grows monotonically so a re-mark after
-- completion can never collide with a still-in-flight older request.
markUnreadRefreshPending:
INSERT INTO UnreadRefreshPending(conversation_id, pending, generation)
VALUES (:conversationId, 1, 0)
ON CONFLICT(conversation_id) DO UPDATE SET pending = 1, generation = UnreadRefreshPending.generation + 1;

getUnreadRefreshPendingConversations:
SELECT conversation_id FROM UnreadRefreshPending WHERE pending = 1;

getUnreadRefreshPendingGeneration:
SELECT generation FROM UnreadRefreshPending
WHERE conversation_id = :conversationId AND pending = 1;

-- Only the task this request actually read may be confirmed; a generation
-- mismatch means a newer journal commit re-marked the conversation and the
-- stale response must NOT retire it.
confirmUnreadRefreshPending:
UPDATE UnreadRefreshPending SET pending = 0
WHERE conversation_id = :conversationId AND pending = 1 AND generation = :expectedGeneration;
CREATE TABLE MessageTimelineState (
    conversation_id TEXT NOT NULL PRIMARY KEY,
    window_generation INTEGER NOT NULL DEFAULT 0
);

getWindowGeneration:
SELECT window_generation FROM MessageTimelineState WHERE conversation_id = :conversationId;

advanceWindowGeneration:
INSERT INTO MessageTimelineState(conversation_id, window_generation)
VALUES (:conversationId, 1)
ON CONFLICT(conversation_id) DO UPDATE SET window_generation = MessageTimelineState.window_generation + 1;

-- Oldest confirmed message currently in the active timeline window.
-- Excludes outbox rows (SENDING/FAILED whose client requestIds must not be
-- sent as server beforeId cursors) and hidden seed rows (in_timeline = 0).
getOldestConfirmedTimelineMessageId:
SELECT id FROM MessageEntity
WHERE conversation_id = :conversationId
  AND in_timeline = 1
  AND (local_send_status IS NULL OR local_send_status = 'SENT')
ORDER BY id ASC
LIMIT 1;

-- 窗口跳变：把窗口之前的已确认消息降级为时间轴外（in_timeline = 0），
-- 而不是物理删除——保住发件箱行（SENDING/FAILED）对外键目标的引用
-- （reply 外键是 ON DELETE SET NULL，物理删除会把待发消息的回复目标置空），
-- 也保留这些行作为回复预览的 JOIN 目标。降级后它们不会出现在
-- Paging 边界与关联查询里。
demoteTimelineBefore:
UPDATE MessageEntity
SET in_timeline = 0
WHERE conversation_id = :conversationId
  AND in_timeline = 1
  AND id < :windowOldestId
  AND (local_send_status IS NULL OR local_send_status NOT IN ('SENDING', 'FAILED'));

demoteAllTimelineMessages:
UPDATE MessageEntity
SET in_timeline = 0
WHERE conversation_id = :conversationId
  AND in_timeline = 1
  AND (local_send_status IS NULL OR local_send_status NOT IN ('SENDING', 'FAILED'));
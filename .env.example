# ============================================
# Docker Compose 环境变量（模板）
# 使用方法：cp .env.example .env 后按需修改。
# 本文件仅含 demo 占位值，可公开提交；
# .env 已被 gitignore，不会进入版本库。
# ============================================

POSTGRES_PASSWORD=demo-password-please-change-in-production
JWT_SECRET=demo-jwt-secret-must-be-changed-for-production-use

# /metrics 接口的 Bearer Token；生产环境必须设置，否则 /metrics 对外开放
# METRICS_TOKEN=generate-a-long-random-token-here

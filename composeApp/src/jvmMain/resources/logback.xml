<configuration>
    <!-- 1. 定义日志文件存放路径：用户主目录下的 logs 文件夹 -->
    <!-- 比如 Windows: C:\Users\用户名\.myclientapp\logs\app.log -->
    <property name="LOG_DIR" value="${user.home}/.chat-multiplatform/logs" />

    <!-- 2. 控制台输出（仅用于你在 IDE 里开发调试时看） -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- 修复了 yyyy 的大小写问题 -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 3. 文件输出（客户端最核心的配置：滚动记录文件，避免撑爆用户硬盘） -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>

        <!-- 每天滚动生成新文件，最多保留 30 天，总大小不超过 1GB -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 4. 全局日志级别控制 -->
    <!-- 提示：客户端生产环境建议设为 INFO，开发排查时再设为 TRACE/DEBUG，否则日志文件增长极快 -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- 5. 屏蔽第三方库多余的刷屏日志 -->
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="io.ktor.client.engine.cio" level="DEBUG" />
    <logger name="io.netty" level="DEBUG" />
</configuration>